# Autostart on a Raspberry Pi / Linux (systemd):
#   cd into the Cam2Wall folder, then:
#   sed "s|@USER@|$USER|g; s|@DIR@|$PWD|g" deploy/cam2wall.service | sudo tee /etc/systemd/system/cam2wall.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now cam2wall
[Unit]
Description=Cam2Wall camera dashboard (go2rtc)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
ExecStart=/bin/sh @DIR@/start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
